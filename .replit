modules = ["nodejs-20", "web", "openjdk-17", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["maven", "openjdk17", "unzip", "imagemagick"]

[deployment]
deploymentTarget = "cloudrun"
build = [
  "sh",
  "-c",
  "npm run build && rm -rf server/public && cp -r dist/public server/public",
]
run = ["sh", "-c", "npm start"]

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Check and Fix"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Production Build"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Production Build"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node optimize-production.cjs && npm run build && NODE_ENV=production node production-start.cjs"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Check and Fix"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/check-missing-endpoints.cjs"

[languages.typescript]
pattern = "**/{*.ts,*.tsx}"
syntax = "typescript"

[languages.typescript.languageServer]
start = ["typescript-language-server", "--stdio"]

[agent]
integrations = [
  "javascript_stripe:1.0.0",
  "perplexity_v0:1.0.0",
  "javascript_object_storage:1.0.0",
  "javascript_openai:1.0.0",
  "javascript_gemini:1.0.0",
]

[userenv]

[userenv.shared]
GOOGLE_CSE_ID = "f343e762f44de42db"
GOOGLE_CUSTOM_SEARCH_ENGINE_ID = "f343e762f44de42db"
VITE_SHOP_URL = "https://store.funnytalez.com/"
VERTEX_AI_SEARCH_PROJECT = "pet-events-search_1778912673631"
VERTEX_AI_SEARCH_DATASTORE = "korean-pet-events_1778914387348"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 900000
